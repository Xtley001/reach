# REACH Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=generate_with__openssl_rand_hex_64
ENVIRONMENT=development

# CORS — comma-separated
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# OTP delivery — use "console" for development (prints to terminal)
OTP_PROVIDER=console
BREVO_API_KEY=
BREVO_SENDER=your-verified-sender@yourdomain.com
ADMIN_BACKUP_EMAIL=admin@example.com

# Redis (Upstash)
REDIS_URL=

# I-93/94: Supabase Storage — same Supabase project as DATABASE_URL above.
# SUPABASE_URL is the project's REST endpoint (https://xxxxx.supabase.co),
# NOT the Postgres connection string. Use the service_role key (not anon) —
# uploads happen server-side. Create a public "avatars" bucket first (see
# DEPLOY.md section on Supabase Storage setup).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATARS_BUCKET=avatars

# Cloudinary — DEPRECATED (I-94), kept only as a rollback path. Leave blank
# once SUPABASE_URL above is set; storage.py prefers Supabase automatically.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# JWT rotation (P0-1.1)
# When rotating: set JWT_SECRET_V1 to old JWT_SECRET, then update JWT_SECRET to new value
# V1 is verify-only — tokens signed with it will still work until they expire
JWT_SECRET_V1=

# Admin OTP CC — disable in production to reduce inbox exposure (P1-1.8)
# Set to "false" in production; "true" only in development/staging
ADMIN_OTP_CC_ENABLED=false

# Optional
SENTRY_DSN=
FRONTEND_URL=http://localhost:5173
